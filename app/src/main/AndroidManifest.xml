<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <package android:name="com.avito.android"/>
        <package android:name="com.idamob.tinkoff.android"/>
        <package android:name="com.vk.vkvideo"/>
        <package android:name="com.vkontakte.android"/>
        <package android:name="com.wildberries.ru"/>
        <package android:name="ru.beru.android"/>
        <package android:name="ru.dublgis.dgismobile"/>
        <package android:name="ru.foodfox.client"/>
        <package android:name="ru.kinopoisk"/>
        <package android:name="ru.mail.mailapp"/>
        <package android:name="ru.megamarket.marketplace"/>
        <package android:name="ru.mts.mymts"/>
        <package android:name="ru.ok.android"/>
        <package android:name="ru.oneme.app"/>
        <package android:name="ru.ozon.app.android"/>
        <package android:name="ru.rostel"/>
        <package android:name="ru.sberbankmobile"/>
        <package android:name="ru.vk.store"/>
        <package android:name="ru.yandex.music"/>
        <package android:name="ru.yandex.taxi"/>
        <package android:name="ru.yandex.yandexmaps"/>
        <package android:name="ru.zen.android"/>
    </queries>
    <application android:enableOnBackInvokedCallback="true" android:allowBackup="false" android:usesCleartextTraffic="false"
        android:label="InvokeVPN" android:icon="@drawable/ic_invoke" android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="invokevpn"/>
            </intent-filter>
        </activity>
        <service android:name=".TunnelService" android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="systemExempted" android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter><action android:name="android.net.VpnService"/></intent-filter>
        </service>
        <service android:name=".VpnTile" android:label="InvokeVPN" android:icon="@drawable/ic_status_vpn"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true"/>
        </service>
        <service android:name=".RefreshJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE"/>
    </application>
</manifest>
